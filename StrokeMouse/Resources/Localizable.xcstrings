    },
    "general.includeHUDInCapturesHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, screenshot and screen recording apps can capture the drawing trail. Whether a window-only capture includes it depends on the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，截图和录屏软件可捕获绘制轨迹；仅捕获单个窗口时是否包含轨迹取决于软件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，截圖和錄屏軟體可捕獲繪製軌跡；僅捕獲單個視窗時是否包含軌跡取決於軟體。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 스크린샷 및 화면 녹화 앱이 그리기 궤적을 캡처할 수 있으며, 단일 윈도우만 캡처할 때 포함 여부는 해당 앱에 따라 다릅니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、スクリーンショットや画面収録のアプリが描画軌跡をキャプチャできます。ウインドウのみのキャプチャに含まれるかはアプリによります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если включено, приложения для снимков и записи экрана могут захватывать след рисования; при захвате только одного окна это зависит от приложения."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois activé, les apps de capture et d’enregistrement d’écran peuvent inclure le tracé ; pour une capture limitée à une fenêtre, cela dépend de l’app."
          }
        }
      }
    },
