    "permissions.automationBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needed when AppleScript actions control other apps. macOS will prompt per-app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 AppleScript 动作控制其他 App 时需要，系统会按应用弹窗请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當 AppleScript 動作控制其他 App 時需要，系統會按應用彈窗請求。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AppleScript 동작이 다른 앱을 제어할 때 필요하며, macOS가 앱마다 요청합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AppleScriptアクションがほかのアプリを制御するときに必要です。macOSがアプリごとに確認します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно, когда действия AppleScript управляют другими приложениями; macOS запросит разрешение для каждого приложения."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Requis lorsque des actions AppleScript contrôlent d’autres apps ; macOS demandera l’autorisation pour chaque app."
          }
        }
      }
    },
