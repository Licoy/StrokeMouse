    "trackpad.experimentalWarning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimental: uses a private system framework and cannot suppress macOS gestures. System actions may happen at the same time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实验性功能：使用系统私有框架，且无法拦截 macOS 原生手势；系统动作可能同时发生。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "實驗性功能：使用系統私有框架，且無法攔截 macOS 原生手勢；系統動作可能同時發生。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실험적 기능이며, 비공개 시스템 프레임워크를 사용하고 macOS 제스처를 억제할 수 없어 시스템 동작이 동시에 일어날 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実験的機能: システムの非公開フレームワークを使用し、macOS標準のジェスチャを抑制できません。システムの動作が同時に発生することがあります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспериментально: используется закрытый системный фреймворк, системные жесты macOS подавить нельзя; системные действия могут выполняться одновременно."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Expérimental : utilise un framework système privé et ne peut pas intercepter les gestes macOS. Les actions système peuvent se produire en même temps."
          }
        }
      }
    },
