    "action.shortcutRecordingHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keys show live as you press. Release all keys to finish; press again to correct; press Esc alone to cancel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键会实时显示；松开全部按键即完成；按错直接重按即可修正；单独按 Esc 取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按鍵會實時顯示；鬆開全部按鍵即完成；按錯直接重按即可修正；單獨按 Esc 取消。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누르는 키가 실시간으로 표시되며, 모든 키를 놓으면 완료되고 다시 누르면 수정되며 Esc만 누르면 취소됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "押したキーがリアルタイムで表示されます。すべてのキーを離すと完了します。やり直すときはもう一度押してください。Escだけを押すとキャンセルします。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиши отображаются сразу при нажатии; отпустите все клавиши, чтобы завершить, нажмите снова, чтобы исправить, или нажмите только Esc, чтобы отменить."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches s’affichent au fur et à mesure. Relâchez toutes les touches pour terminer ; appuyez de nouveau pour corriger ; appuyez uniquement sur Esc pour annuler."
          }
        }
      }
    },
    "action.shortcutRecorderNeedPermission": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot start keyboard capture. Grant Accessibility permission and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启动键盘捕获，请授予辅助功能权限后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法啟動鍵盤捕獲，請授予輔助使用許可權後重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키보드 캡처를 시작할 수 없으니, 손쉬운 사용 권한을 허용한 뒤 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーボードの取り込みを開始できません。アクセシビリティを許可してからやり直してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось начать захват клавиатуры. Предоставьте доступ «Универсальный доступ» и повторите попытку."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de démarrer la capture clavier. Accordez l’autorisation d’accessibilité, puis réessayez."
          }
        }
      }
    },
    "action.shortcutUnsupportedModifier": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only Command, Option, Control, and Shift are supported as modifier keys."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅支持 Command、Option、Control 和 Shift 作为修饰键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅支援 Command、Option、Control 和 Shift 作為修飾鍵。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보조 키는 Command, Option, Control, Shift만 지원됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修飾キーとして使えるのは Command、Option、Control、Shift のみです。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В качестве модификаторов поддерживаются только Command, Option, Control и Shift."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls Command, Option, Control et Shift sont pris en charge comme touches de modification."
          }
        }
      }
    },
