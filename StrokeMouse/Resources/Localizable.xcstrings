    "sync.error.rollback": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local rollback could not be created, so nothing was applied."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建本地回滚，因此未应用任何配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法建立本地回滾，因此未應用任何配置。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 롤백을 만들지 못해 아무것도 적용되지 않았습니다."
          }
        },
        "ja": {
