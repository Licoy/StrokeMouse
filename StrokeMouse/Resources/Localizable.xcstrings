    "sync.history.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a snapshot to download, decrypt, fully validate, and compare it. Viewing history never changes this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择快照后会下载、解密、完整验证并生成比较；查看历史不会修改本机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇快照後會下載、解密、完整驗證並生成比較；檢視歷史不會修改本機。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스냅샷을 선택하면 다운로드, 복호화, 전체 검증, 비교가 이루어지며, 기록을 본다고 이 Mac이 바뀌지는 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スナップショットを選ぶと、ダウンロード、復号、完全な検証、比較が行われます。履歴の表示ではこのMacは変更されません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите снимок, чтобы загрузить, расшифровать, полностью проверить и сравнить его. Просмотр истории никогда не изменяет этот Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un instantané pour le télécharger, le déchiffrer, le valider entièrement et le comparer. Consulter l’historique ne modifie jamais ce Mac."
          }
        }
      }
    },
