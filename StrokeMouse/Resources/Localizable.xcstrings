    "sync.webdav.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups are stored under a fixed StrokeMouse folder. Basic and Digest authentication are supported."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份会保存到固定的 StrokeMouse 目录；支持 Basic 与 Digest 认证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份會儲存到固定的 StrokeMouse 目錄；支援 Basic 與 Digest 認證。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업은 고정된 StrokeMouse 폴더에 저장되며, Basic 및 Digest 인증을 지원합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップは固定のStrokeMouseフォルダに保存されます。Basic認証とDigest認証に対応しています。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервные копии сохраняются в фиксированной папке StrokeMouse. Поддерживается аутентификация Basic и Digest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes sont stockées dans un dossier StrokeMouse fixe. L’authentification Basic et Digest est prise en charge."
          }
        }
      }
    },
    "sync.webdav.httpConfirmation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I understand HTTP can expose credentials and allow plaintext backups to be read or tampered with"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我了解 HTTP 可能泄露凭据，也可能使明文备份被读取或篡改"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我瞭解 HTTP 可能洩露憑據，也可能使明文備份被讀取或篡改"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP가 자격 증명을 노출하고 평문 백업이 읽히거나 변조될 수 있음을 이해합니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPでは認証情報が漏れたり、平文バックアップが読まれたり改ざんされたりする可能性があることを理解しています"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я понимаю, что HTTP может раскрыть учётные данные и позволить прочитать или изменить незашифрованные резервные копии"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je comprends que HTTP peut exposer les identifiants et permettre la lecture ou l’altération des sauvegardes en clair"
          }
        }
      }
    },
    "sync.webdav.httpWarning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP credentials can be intercepted, and plaintext backups can be read or tampered with in transit. AES protects backup payloads only; it does not protect the WebDAV login."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP 凭据可能被窃听，明文备份也可能在传输中被读取或篡改；AES 只保护备份正文，无法保护 WebDAV 登录信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP 憑據可能被竊聽，明文備份也可能在傳輸中被讀取或篡改；AES 只保護備份正文，無法保護 WebDAV 登入資訊。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP 자격 증명은 가로채일 수 있고 평문 백업은 전송 중 읽히거나 변조될 수 있으며, AES는 백업 본문만 보호하고 WebDAV 로그인은 보호하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTPの認証情報は傍受されることがあり、平文バックアップも転送中に読まれたり改ざんされたりすることがあります。AESはバックアップ本文のみを保護し、WebDAVのログインは保護しません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учётные данные HTTP могут быть перехвачены, а незашифрованные резервные копии — прочитаны или изменены при передаче. AES защищает только содержимое резервной копии и не защищает вход в WebDAV."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les identifiants HTTP peuvent être interceptés, et les sauvegardes en clair peuvent être lues ou altérées en transit. AES protège uniquement le contenu des sauvegardes, pas la connexion WebDAV."
          }
        }
      }
    },
    "sync.webdav.httpTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
