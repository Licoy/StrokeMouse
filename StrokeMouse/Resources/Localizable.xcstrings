    "editor.scopeGlobalHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Works in every app unless an app or app group turns global gestures off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在所有应用中生效，可在应用或应用组中停用全局手势。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在所有應用中生效，可在應用或應用組中停用全域手勢。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 앱에서 작동하며, 앱이나 앱 그룹에서 전역 제스처를 끌 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのアプリで有効です。アプリやアプリグループ側でグローバルジェスチャをオフにできます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работает во всех приложениях; глобальные жесты можно отключить для приложения или группы."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne dans toutes les apps ; une app ou un groupe peut désactiver les gestes globaux."
          }
        }
      }
    },
    "editor.scopeGroupEmpty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No app groups yet. Create one from the sidebar of the gesture list."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有应用组，可在手势列表的侧边栏新建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無應用組，可在手勢列表的側邊欄新增。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 그룹이 없습니다. 제스처 목록 사이드바에서 만들 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリグループはまだありません。ジェスチャ一覧のサイドバーから作成できます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Групп приложений пока нет; создайте её на боковой панели списка жестов."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun groupe d’apps pour l’instant ; créez-en un depuis la barre latérale de la liste des gestes."
          }
        }
      }
    },
    "editor.scopeGroupHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs in every app of the group. Precedence: selected apps, then app groups, then global."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在组内所有应用中生效，优先级为指定应用 > 应用组 > 全局。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在組內所有應用中生效，優先順序為指定應用 > 應用組 > 全域。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹의 모든 앱에서 작동합니다. 우선순위: 선택한 앱 > 앱 그룹 > 전체"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループ内のすべてのアプリで有効です。優先順位：選択したアプリ > アプリグループ > グローバル"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работает во всех приложениях группы. Приоритет: выбранные приложения > группы > глобальные."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique à toutes les apps du groupe. Priorité : apps sélectionnées > groupes > toutes les apps."
          }
        }
      }
    },
