    "general.matchThresholdHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower values are more sensitive and may conflict with similar gestures. Reversed, mirrored or clearly incomplete strokes are still rejected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数值越低越容易触发，也越可能与相似手势冲突；反向、镜像或明显不完整的轨迹仍会被拒绝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "數值越低越容易觸發，也越可能與相似手勢衝突；反向、鏡像或明顯不完整的軌跡仍會被拒絕。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값이 낮을수록 더 민감하며 비슷한 제스처와 충돌할 수 있고, 반대 방향·좌우 반전·명확히 불완전한 궤적은 여전히 거부됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値を下げると反応しやすくなりますが、似たジェスチャと衝突しやすくなります。逆方向・左右反転・明らかに不完全な軌跡は引き続き拒否されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меньшие значения повышают чувствительность и могут конфликтовать с похожими жестами; обратные, зеркальные и явно незавершённые траектории по-прежнему отклоняются."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une valeur plus basse est plus sensible et peut entrer en conflit avec des gestes similaires ; les tracés inversés, en miroir ou nettement incomplets restent refusés."
          }
        }
      }
    },
