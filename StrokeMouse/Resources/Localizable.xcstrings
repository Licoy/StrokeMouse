    "editor.recordUseLeftButtonBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press and hold the left mouse button, then drag to record the gesture path on this canvas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住鼠标左键并拖动，在此画布上录制手势轨迹。"
