    "editor.scopeHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When Global is off, this gesture only runs when the selected target belongs to one of these apps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭全局后，仅当所选手势目标属于以下应用时，此手势才会生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉全域性後，僅當所選手勢目標屬於以下應用時，此手勢才會生效。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체를 끄면 선택한 대상이 다음 앱 중 하나에 속할 때만 이 제스처가 실행됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グローバルをオフにすると、選択したジェスチャ対象が次のアプリのいずれかに属するときだけ、このジェスチャが実行されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если режим «Глобально» выключен, жест выполняется только когда выбранная цель принадлежит одному из этих приложений."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque Global est désactivé, ce geste ne s’exécute que si la cible sélectionnée appartient à l’une de ces apps."
          }
        }
      }
    },
