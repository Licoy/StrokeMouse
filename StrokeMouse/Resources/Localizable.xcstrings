    "sync.automatic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic Backups"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动备份"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動備份"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 백업"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動バックアップ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматическое резервное копирование"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegardes automatiques"
          }
        }
      }
    },
    "sync.automatic.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back up 60 seconds after configuration changes and check hourly; runs only while StrokeMouse is open."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置停止变化 60 秒后备份，并每小时检查一次；仅在 StrokeMouse 运行时执行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配置停止變化 60 秒後備份，並每小時檢查一次；僅在 StrokeMouse 執行時執行。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구성이 바뀐 뒤 60초에 백업하고 매시간 확인하며, StrokeMouse가 열려 있을 때만 실행됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定の変更が止まってから60秒後にバックアップし、1時間ごとに確認します。StrokeMouseの起動中のみ実行されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервная копия создаётся через 60 секунд после изменения конфигурации, затем выполняется ежечасная проверка; только пока открыт StrokeMouse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegarde 60 secondes après les modifications de configuration et vérification toutes les heures ; uniquement lorsque StrokeMouse est ouvert."
          }
        }
      }
    },
    "sync.remoteGrowthWarning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote history is never cleaned automatically, so provider storage usage can keep growing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远端历史永不自动清理，因此服务商存储占用可能持续增长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端歷史永不自動清理，因此服務商儲存佔用可能持續增長。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 기록은 자동으로 정리되지 않으므로 제공자 저장 공간이 계속 늘어날 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートの履歴は自動では削除されないため、プロバイダのストレージ使用量は増え続けることがあります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалённая история никогда не очищается автоматически, поэтому использование хранилища службы может постоянно расти."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique distant n’est jamais nettoyé automatiquement, l’espace utilisé chez le service peut donc continuer d’augmenter."
          }
        }
      }
    },
    "sync.uploadOnlyFooter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic work only uploads versioned backups; it never downloads, merges, or overwrites this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动任务只会上传版本化备份；绝不会下载、合并或覆盖本机配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動任務只會上傳版本化備份；絕不會下載、合併或覆蓋本機配置。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 작업은 버전 있는 백업만 업로드하며, 이 Mac을 다운로드, 병합, 덮어쓰지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動処理はバージョン付きバックアップのアップロードのみです。このMacへのダウンロード、結合、上書きは行いません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматические задачи только выгружают версионированные резервные копии; они никогда не загружают, не объединяют и не перезаписывают этот Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches automatiques n’envoient que des sauvegardes versionnées ; elles ne téléchargent, ne fusionnent ni n’écrasent jamais ce Mac."
          }
        }
      }
    },
    "sync.status": {
      "localizations": {
