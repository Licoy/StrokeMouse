    "general.triggerButtonHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deprecated: trigger buttons are configured per gesture."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已弃用：触发键在每条手势中单独配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已棄用：觸發鍵在每條手勢中單獨配置。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용되지 않음: 트리거 버튼은 제스처마다 구성합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非推奨: トリガーボタンはジェスチャごとに設定します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устарело: кнопки триггера задаются отдельно для каждого жеста."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsolète : les boutons de déclenchement se règlent pour chaque geste."
          }
        }
      }
    },
    "general.engineFooter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trigger mouse button is set on each gesture (default: right button). Short-click still opens the system menu; drag past the minimum distance to draw a gesture."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触发键在每条手势中单独设置（默认右键）；短按仍弹出系统菜单；拖过最小滑动距离才视为手势。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "觸發鍵在每條手勢中單獨設定（預設右鍵）；短按仍彈出系統選單；拖過最小滑動距離才視為手勢。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트리거 마우스 버튼은 각 제스처에서 설정하며(기본값: 오른쪽 버튼), 짧게 클릭하면 시스템 메뉴가 열리고 최소 거리를 넘겨 드래그해야 제스처로 그립니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トリガーとなるマウスボタンはジェスチャごとに設定します（デフォルトは右ボタン）。短いクリックではシステムのメニューが開きます。最小距離を超えてドラッグするとジェスチャとして描画します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопка мыши-триггер задаётся для каждого жеста (по умолчанию — правая). Короткий щелчок по-прежнему открывает системное меню; перетащите дальше минимальной дистанции, чтобы нарисовать жест."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bouton de déclenchement se règle pour chaque geste (par défaut : bouton droit). Un clic court ouvre encore le menu système ; faites glisser au-delà de la distance minimale pour dessiner un geste."
          }
        }
      }
    },
    "editor.triggerGlobalHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deprecated: use per-gesture trigger button."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已弃用：请使用每条手势的触发键设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已棄用：請使用每條手勢的觸發鍵設定。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용되지 않음: 제스처별 트리거 버튼을 사용하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非推奨: ジェスチャごとのトリガーボタンを使ってください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устарело: используйте кнопку триггера у каждого жеста."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsolète : utilisez le bouton de déclenchement de chaque geste."
          }
        }
      }
    },
    "editor.triggerPerGestureHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold this button, draw the path, then release to run the action. Different gestures can use different buttons."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住此按键绘制轨迹，松开后执行动作；不同手势可使用不同触发键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住此按鍵繪製軌跡，鬆開後執行動作；不同手勢可使用不同觸發鍵。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 버튼을 누른 채 경로를 그린 다음 놓으면 동작이 실행되며, 제스처마다 다른 버튼을 사용할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このボタンを押したまま軌跡を描き、離すとアクションが実行されます。ジェスチャごとに異なるボタンを使えます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте эту кнопку, нарисуйте траекторию и отпустите, чтобы выполнить действие; у разных жестов могут быть разные кнопки."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez ce bouton, dessinez le tracé, puis relâchez pour exécuter l’action ; différents gestes peuvent utiliser différents boutons."
          }
        }
      }
    },
