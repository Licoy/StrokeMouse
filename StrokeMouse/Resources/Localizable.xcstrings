    "general.languageHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Takes effect immediately. The settings window stays open and refreshes to the selected language."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即生效，设置窗口会保持打开，并刷新为所选语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即生效，設定視窗會保持開啟，並重新整理為所選語言。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즉시 적용되며, 설정 창은 열린 채로 선택한 언어로 새로 고쳐집니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐに反映されます。設定ウインドウは開いたまま、選択した言語に更新されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вступает в силу сразу; окно настроек остаётся открытым и обновляется на выбранный язык."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prend effet immédiatement ; la fenêtre des réglages reste ouverte et se rafraîchit dans la langue choisie."
          }
        }
      }
    },
