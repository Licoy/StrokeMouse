    "appGroup.editor.patternHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use * for any characters, e.g. com.adobe.*, unity.*, *.godot. Matching ignores case."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 * 匹配任意字符，例如 com.adobe.*、unity.*、*.godot，不区分大小写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 * 符合任意字元，例如 com.adobe.*、unity.*、*.godot，不區分大小寫。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "*는 임의의 문자와 일치합니다. 예: com.adobe.*, unity.*, *.godot (대소문자 구분 안 함)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "* は任意の文字に一致します。例：com.adobe.*、unity.*、*.godot（大文字と小文字は区別しません）"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "* обозначает любые символы, например com.adobe.*, unity.*, *.godot. Регистр не учитывается."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "* remplace n’importe quels caractères, p. ex. com.adobe.*, unity.*, *.godot. La casse est ignorée."
          }
        }
      }
    },
    "appGroup.editor.patternInvalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A rule can’t be empty or contain spaces."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "规则不能为空或包含空格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "規則不能為空或包含空格。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "규칙은 비어 있거나 공백을 포함할 수 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールは空にできず、スペースも含められません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Правило не может быть пустым или содержать пробелы."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une règle ne peut pas être vide ni contenir d’espaces."
          }
        }
      }
    },
    "appGroup.editor.patternMatchesAll": {
