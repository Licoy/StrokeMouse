    "editor.directionsHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comma-separated: up, down, left, right, upLeft, upRight, downLeft, downRight."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逗号分隔：up, down, left, right, upLeft, upRight, downLeft, downRight。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "逗號分隔：up, down, left, right, upLeft, upRight, downLeft, downRight。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쉼표로 구분: up, down, left, right, upLeft, upRight, downLeft, downRight."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カンマ区切り: up, down, left, right, upLeft, upRight, downLeft, downRight。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Через запятую: up, down, left, right, upLeft, upRight, downLeft, downRight."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Séparés par des virgules : up, down, left, right, upLeft, upRight, downLeft, downRight."
          }
        }
      }
    },
    "editor.freePathHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw a template path in the canvas. Matching uses normalize + DTW/resample scoring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在画布中绘制模板轨迹，匹配使用归一化 + 重采样/DTW 打分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在畫布中繪製模板軌跡，匹配使用歸一化 + 重取樣/DTW 打分。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캔버스에 템플릿 경로를 그리며, 일치는 정규화 + DTW/리샘플 점수를 사용합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンバスにテンプレートの軌跡を描きます。照合は正規化とリサンプル/DTWのスコアを使います。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нарисуйте шаблон траектории на холсте; сопоставление использует нормализацию и оценку DTW/передискретизации."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessinez un tracé modèle dans la zone de dessin. La correspondance utilise une normalisation et un score DTW/rééchantillonnage."
          }
        }
      }
    },
    "editor.drawHere": {
