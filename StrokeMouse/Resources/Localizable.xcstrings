    "action.appleScriptWarning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AppleScript runs with your user privileges and may control other apps. Only add trusted scripts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AppleScript 以当前用户权限执行，并可能控制其他 App，请只添加可信脚本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AppleScript 以當前使用者許可權執行，並可能控制其他 App，請只新增可信指令碼。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AppleScript는 사용자 권한으로 실행되며 다른 앱을 제어할 수 있으므로 신뢰할 수 있는 스크립트만 추가하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AppleScriptは現在のユーザ権限で実行され、ほかのアプリを制御することがあります。信頼できるスクリプトだけを追加してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
