    "gestureTest.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an input mode to inspect production recognition. Diagnostics never runs actions or applies app scope."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择输入方式查看正式识别结果，诊断模式不会执行动作，也不受应用范围限制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇輸入方式檢視正式識別結果，診斷模式不會執行動作，也不受應用範圍限制。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력 방식을 선택해 실제 인식 결과를 확인하며, 진단 모드에서는 동작을 실행하지 않고 앱 범위도 적용하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力方式を選んで本番の認識結果を確認します。診断ではアクションは実行されず、アプリ範囲も適用されません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите режим ввода, чтобы проверить рабочее распознавание; диагностика не выполняет действия и не применяет область приложений."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un mode d’entrée pour examiner la reconnaissance réelle ; le diagnostic n’exécute jamais d’actions et n’applique pas la portée des apps."
