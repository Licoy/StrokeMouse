    "editor.targetHelp.frontmostWindow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Freeze the frontmost app when the trigger is pressed, plus its active window when one is available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下触发键时锁定当前前台应用；若存在活动窗口，则同时锁定该窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按下觸發鍵時鎖定當前前臺應用；若存在活動視窗，則同時鎖定該視窗。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트리거를 누를 때 전면 앱을 고정하고, 활성 윈도우가 있으면 해당 윈도우도 함께 고정합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トリガーを押した時点の最前面のアプリを固定します。アクティブなウインドウがあれば、そのウインドウも固定します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При нажатии триггера фиксируется переднее приложение и его активное окно, если оно есть."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouille l’app au premier plan à l’appui du déclencheur, ainsi que sa fenêtre active si elle est disponible."
          }
        }
      }
    },
    "editor.targetHelp.windowUnderPointer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Freeze the app under the pointer when the trigger is pressed, plus the exact window when one is available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下触发键时锁定指针位置所属应用；若存在普通窗口，则同时锁定该窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按下觸發鍵時鎖定指標位置所屬應用；若存在普通視窗，則同時鎖定該視窗。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트리거를 누를 때 포인터 아래 앱을 고정하고, 해당 윈도우가 있으면 정확한 윈도우도 함께 고정합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トリガーを押した時点でポインタ下のアプリを固定します。通常のウインドウがあれば、そのウインドウも固定します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При нажатии триггера фиксируется приложение под указателем и точное окно, если оно есть."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouille l’app sous le pointeur à l’appui du déclencheur, ainsi que la fenêtre exacte si elle est disponible."
          }
        }
      }
    },
    "editor.targetPointerShortcutWarning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts bring the frozen app to the front and, when available, its exact window. This may switch focus or Spaces."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷键会先将锁定应用置于前台；若有精确窗口，也会置前该窗口，因此可能切换焦点或桌面空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷鍵會先將鎖定應用置於前臺；若有精確視窗，也會置前該視窗，因此可能切換焦點或桌面空間。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키는 고정된 앱을 전면으로 가져오고, 가능한 경우 정확한 윈도우도 가져오므로 포커스나 공간이 바뀔 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットは固定したアプリを最前面にします。可能な場合はそのウインドウも最前面になるため、フォーカスやスペースが切り替わることがあります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетания клавиш выводят зафиксированное приложение на передний план и, если доступно, его точное окно; из‑за этого может смениться фокус или рабочий стол Spaces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis amènent l’app verrouillée au premier plan et, si possible, sa fenêtre exacte ; cela peut changer le focus ou l’espace."
          }
        }
      }
    },
    "editor.testActionNeedsTarget": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action needs target context captured at gesture start. Save, then perform the gesture to test it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此动作需要在手势开始时捕获目标上下文，请保存后用真实手势测试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此動作需要在手勢開始時捕獲目標上下文，請儲存後用真實手勢測試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 동작은 제스처 시작 시 캡처된 대상 맥락이 필요하므로, 저장한 뒤 실제 제스처로 테스트하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアクションには、ジェスチャ開始時に取り込んだ対象の情報が必要です。保存したあと、実際のジェスチャでテストしてください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этому действию нужен контекст цели, захваченный в начале жеста; сохраните жест и выполните его, чтобы проверить."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action nécessite le contexte de cible capturé au début du geste ; enregistrez, puis exécutez le geste pour la tester."
          }
        }
      }
    },
