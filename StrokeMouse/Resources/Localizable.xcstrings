    "sync.plaintext.warning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestures can contain Shell commands, AppleScript, URLs, app identifiers, notes, and device information."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手势可能包含 Shell 命令、AppleScript、URL、应用标识、备注与本机信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手勢可能包含 Shell 命令、AppleScript、URL、應用標識、備註與本機資訊。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제스처에는 Shell 명령어, AppleScript, URL, 앱 식별자, 메모, 기기 정보가 포함될 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジェスチャにはShellコマンド、AppleScript、URL、アプリ識別子、メモ、デバイス情報が含まれることがあります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жесты могут содержать команды Shell, AppleScript, URL, идентификаторы приложений, заметки и сведения об устройстве."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les gestes peuvent contenir des commandes Shell, de l’AppleScript, des URL, des identifiants d’apps, des remarques et des informations sur l’appareil."
          }
        }
      }
    },
    "sync.plaintext.confirmation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I understand the provider can read plaintext backup content"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我了解服务商可以读取明文备份内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我瞭解服務商可以讀取明文備份內容"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자가 평문 백업 내용을 읽을 수 있음을 이해합니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サービス提供者が平文のバックアップ内容を読めることを理解しています"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я понимаю, что служба может читать содержимое незашифрованной резервной копии"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je comprends que le service peut lire le contenu des sauvegardes en clair"
          }
        }
      }
    },
