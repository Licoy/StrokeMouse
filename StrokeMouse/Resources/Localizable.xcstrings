    "general.quitAppFooter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needed when the menu bar icon is hidden. You can also press ⌘Q while this window is frontmost."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏菜单栏图标时请从这里完全退出应用；设置窗口在前台时也可按 ⌘Q。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏選單欄圖示時請從這裡完全退出應用；設定視窗在前臺時也可按 ⌘Q。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대 아이콘을 가렸을 때 필요하며, 이 윈도우가 전면일 때 ⌘Q를 눌러도 됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーアイコンを非表示にしているときに使います。このウインドウが最前面のときは⌘Qでも終了できます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно, когда значок в строке меню скрыт. Также можно нажать ⌘Q, когда это окно активно."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessaire lorsque l’icône de la barre des menus est masquée. Vous pouvez aussi appuyer sur ⌘Q lorsque cette fenêtre est au premier plan."
          }
        }
      }
    },
