    "gestures.configRecovery.confirmTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back Up and Restore Defaults?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份原文件并恢复默认配置？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份原檔案並恢復預設配置？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본을 백업하고 기본값으로 복원할까요?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップしてデフォルトに戻しますか？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создать резервную копию и восстановить стандартные настройки?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegarder et restaurer les valeurs par défaut ?"
          }
        }
      }
    },
    "gestures.configRecovery.confirmMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StrokeMouse will preserve the existing file byte-for-byte in a new recovery backup, then replace it with the seven default mouse gestures."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "StrokeMouse 会先将现有文件原样保存为新的恢复备份，再用七条默认鼠标手势替换它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "StrokeMouse 會先將現有檔案原樣儲存為新的恢復備份，再用七條預設滑鼠手勢替換它。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "StrokeMouse는 기존 파일을 바이트 단위로 새 복구 백업에 보존한 다음 기본 마우스 제스처 7개로 교체합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "StrokeMouseは既存ファイルをバイト単位で新しい復元バックアップに保存してから、7つのデフォルトマウスジェスチャで置き換えます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "StrokeMouse сохранит существующий файл побайтово в новой резервной копии восстановления, затем заменит его семью жестами рисования мышью по умолчанию."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "StrokeMouse conservera le fichier existant octet par octet dans une nouvelle sauvegarde de récupération, puis le remplacera par les sept gestes de souris par défaut."
          }
        }
      }
    },
