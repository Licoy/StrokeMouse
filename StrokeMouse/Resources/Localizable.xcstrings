    "gestures.importDuplicatesFooter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Force import will add copies and leave them disabled. You can also skip the duplicates."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强制导入将添加副本，且默认不启用；也可选择跳过重复项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "強制匯入將新增副本，且預設不啟用；也可選擇跳過重複項。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강제 가져오기는 복사본을 추가하고 비활성 상태로 두며, 중복 항목을 건너뛸 수도 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "強制的に読み込むとコピーを追加し、無効のまま残します。重複をスキップすることもできます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Принудительный импорт добавит копии и оставит их отключёнными; также можно пропустить повторы."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’importation forcée ajoute des copies et les laisse désactivées ; vous pouvez aussi ignorer les doublons."
          }
        }
      }
    },
