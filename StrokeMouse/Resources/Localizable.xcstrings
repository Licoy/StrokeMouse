          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После предпросмотра локальные жесты или настройки изменились. Перед восстановлением снова просмотрите этот снимок."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les gestes ou réglages locaux ont changé après l’aperçu. Prévisualisez à nouveau cet instantané avant de restaurer."
          }
        }
      }
    },
