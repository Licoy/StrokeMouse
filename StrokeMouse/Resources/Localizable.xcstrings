    "sync.disconnect.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StrokeMouse will stop scheduling backups and remove local credentials. Remote Gist or WebDAV files will remain unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "StrokeMouse 将停止定时备份并删除本机凭据；远端 Gist 或 WebDAV 文件保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "StrokeMouse 將停止定時備份並刪除本機憑據；遠端 Gist 或 WebDAV 檔案保持不變。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "StrokeMouse는 예약 백업을 멈추고 로컬 자격 증명을 제거하며, 원격 Gist 또는 WebDAV 파일은 그대로 둡니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "StrokeMouseは定期バックアップを停止し、ローカルの認証情報を削除します。リモートのGistまたはWebDAVファイルはそのまま残ります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "StrokeMouse перестанет планировать резервное копирование и удалит локальные учётные данные. Удалённые файлы Gist или WebDAV останутся без изменений."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "StrokeMouse cessera de planifier les sauvegardes et supprimera les identifiants locaux. Les fichiers Gist ou WebDAV distants resteront inchangés."
          }
        }
      }
    },
