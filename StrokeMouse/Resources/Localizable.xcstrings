    "editor.modifierDrawHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold exactly this one modifier and move the pointer. Keyboard events are never consumed; a mouse can technically move the same path."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅按住该修饰键并移动指针，键盘事件不会被吞掉；技术上鼠标也可以移动同一条轨迹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅按住該修飾鍵並移動指標，鍵盤事件不會被吞掉；技術上滑鼠也可以移動同一條軌跡。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 보조 키 하나만 정확히 누른 채 포인터를 움직이며, 키보드 이벤트는 소비되지 않고 마우스로도 같은 경로를 그릴 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この修飾キーだけを押しながらポインタを動かします。キーボードイベントは消費されません。技術的にはマウスでも同じ軌跡を描けます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте ровно эту одну клавишу-модификатор и перемещайте указатель. События клавиатуры не поглощаются; технически ту же траекторию можно провести и мышью."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez exactement cette seule touche de modification et déplacez le pointeur. Les événements clavier ne sont jamais interceptés ; une souris peut techniquement tracer le même chemin."
          }
        }
      }
    },
    "editor.trackpadModifierSupport": {
