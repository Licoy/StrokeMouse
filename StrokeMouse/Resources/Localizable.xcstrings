    "appRule.group.emptyMatchers": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No apps or rules yet, so this group matches no app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未添加应用或规则，此应用组不会匹配任何应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未新增應用或規則，此應用組不會符合任何應用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 앱이나 규칙이 없어 이 그룹은 어떤 앱과도 일치하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリやルールがまだないため、このグループはどのアプリにも一致しません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нет приложений или правил, поэтому группа не подходит ни одному приложению."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune app ni règle pour l’instant : ce groupe ne correspond à aucune app."
          }
        }
      }
    },
