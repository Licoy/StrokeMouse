    "sync.error.previewOutdated": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local gestures or settings changed after the preview. Preview this snapshot again before restoring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览后本机手势或选项已变化，恢复前请重新预览此快照。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預覽後本機手勢或選項已變化，恢復前請重新預覽此快照。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기 이후 로컬 제스처나 설정이 바뀌었으니, 복원하기 전에 이 스냅샷을 다시 미리보세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
