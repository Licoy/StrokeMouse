    "update.unavailableInDevelopment": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update checks are unavailable in development or non-app runs. Use a signed .app release build."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发模式或非 .app 运行环境无法检查更新，请使用已签名的发布版 .app。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開發模式或非 .app 執行環境無法檢查更新，請使用已簽名的釋出版 .app。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발 모드나 앱이 아닌 실행에서는 업데이트 확인을 사용할 수 없으니, 서명된 .app 출시 빌드를 사용하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発モードまたは.app以外の実行ではアップデートを確認できません。署名済みのリリース版.appを使用してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка обновлений недоступна в режиме разработки или при запуске не из .app. Используйте подписанную релизную сборку .app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche de mises à jour n’est pas disponible en mode développement ou hors app. Utilisez une version .app signée."
          }
        }
      }
    },
    "update.signingKeyMissing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparkle public key is not configured yet. This will work after open-source release signing is set up."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未配置 Sparkle 公钥，完成开源发版签名配置后即可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未配置 Sparkle 公鑰，完成開源發版簽名配置後即可使用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparkle 공개 키가 아직 구성되지 않았으며, 오픈 소스 출시 서명이 설정되면 사용할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparkleの公開鍵がまだ設定されていません。オープンソースのリリース署名が整うと利用できます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открытый ключ Sparkle ещё не настроен. Функция заработает после настройки подписи открытого релиза."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé publique Sparkle n’est pas encore configurée. Cela fonctionnera une fois la signature des versions open source mise en place."
          }
        }
      }
    },
    "update.updaterUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update service could not start. Relaunch StrokeMouse and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
