    "sync.gist.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The token needs write access to Gists. A secret Gist is unlisted, but its plaintext remains visible to GitHub."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "令牌需要 Gists 写入权限；secret Gist 只是不公开列出，明文内容仍对 GitHub 可见。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "令牌需要 Gists 寫入許可權；secret Gist 只是不公開列出，明文內容仍對 GitHub 可見。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "토큰에 Gist 쓰기 권한이 필요하며, 비밀 Gist는 목록에 없지만 평문은 여전히 GitHub에 보입니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークンにはGistの書き込み権限が必要です。secret Gistは一覧に公開されませんが、平文の内容はGitHubから見えます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Токену нужны права на запись в Gists. Секретный Gist не отображается в списках, но его открытый текст по-прежнему виден GitHub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeton doit pouvoir écrire dans les Gists. Un Gist secret n’est pas listé publiquement, mais son contenu en clair reste visible pour GitHub."
          }
        }
      }
    },
    "sync.gist.visibilityConfirmation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have checked the existing Gist's visibility and understand it may be public"
