    "general.feedbackHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toasts appear after a gesture ends. Action errors always show, even when these are off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示在手势结束后显示；即使关闭以上选项，动作执行失败仍会提示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提示在手勢結束後顯示；即使關閉以上選項，動作執行失敗仍會提示。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "토스트는 제스처가 끝난 뒤 나타나며, 이 옵션이 꺼져 있어도 동작 오류는 항상 표시됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知はジェスチャ終了後に表示されます。これらをオフにしても、アクションのエラーは常に表示されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления появляются после завершения жеста. Ошибки выполнения действий всегда отображаются, даже если эти параметры выключены."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications apparaissent à la fin d’un geste ; les erreurs d’action s’affichent toujours, même si ces options sont désactivées."
          }
        }
      }
    },
    "general.showLiveMismatchFeedback": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Real-time Unrecognized Feedback"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时未识别反馈"
          }
        },
        "zh-Hant": {
