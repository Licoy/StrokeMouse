    "config.failure.tooManyDrawnSamples": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drawn gesture %@ may contain at most five samples."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绘制手势 %@ 最多可包含五个样本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繪製手勢 %@ 最多可包含五個樣本。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그리기 제스처 %@에는 샘플을 최대 5개까지 포함할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "描画ジェスチャ %@ に含められるサンプルは最大5つです。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рисованный жест %@ может содержать не более пяти образцов."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le geste dessiné %@ peut contenir au maximum cinq échantillons."
          }
        }
      }
    },
    "config.failure.zeroLengthDrawnPath": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each sample in drawn gesture %@ must contain a non-zero-length path."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绘制手势 %@ 的每个样本都必须包含非零长度的轨迹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繪製手勢 %@ 的每個樣本都必須包含非零長度的軌跡。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그리기 제스처 %@의 각 샘플에는 길이가 0이 아닌 경로가 있어야 합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "描画ジェスチャ %@ の各サンプルには長さが0ではない軌跡が必要です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый образец рисованного жеста %@ должен содержать траекторию ненулевой длины."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque échantillon du geste dessiné %@ doit contenir un tracé de longueur non nulle."
          }
        }
      }
    },
