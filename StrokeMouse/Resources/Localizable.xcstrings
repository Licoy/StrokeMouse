    "update.sectionFooter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks run hourly when enabled. Updates download and install only after you confirm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后每小时检查一次；更新只会在你确认后下载和安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用後每小時檢查一次；更新只會在你確認後下載和安裝。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 매시간 확인하며, 업데이트는 확인한 후에만 다운로드 및 설치됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると1時間ごとに確認します。アップデートのダウンロードとインストールは、確認したあとにのみ行われます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При включении проверка выполняется каждый час; обновления загружаются и устанавливаются только после вашего подтверждения."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vérifications s’effectuent toutes les heures une fois activées. Les mises à jour ne sont téléchargées et installées qu’après votre confirmation."
          }
        }
      }
    },
