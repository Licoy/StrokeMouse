    "sync.restore.confirmMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected, fully validated snapshot will be applied only after a local rollback is written."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在本地回滚写入成功后，才会应用已完整验证的所选快照。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在本地回滾寫入成功後，才會應用已完整驗證的所選快照。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 롤백이 기록된 후에만 선택되고 완전히 검증된 스냅샷이 적용됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルロールバックの書き込みが成功したあとでのみ、完全に検証済みの選択スナップショットが適用されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранный и полностью проверенный снимок будет применён только после записи локального отката."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’instantané sélectionné et entièrement validé ne sera appliqué qu’après l’écriture d’une restauration locale."
          }
        }
      }
    },
