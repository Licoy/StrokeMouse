          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마우스 왼쪽 버튼을 누른 채 드래그하여 이 캔버스에 제스처 경로를 기록하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウスの左ボタンを押したままドラッグして、このキャンバスにジェスチャの軌跡を記録します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте левую кнопку мыши и перетаскивайте, чтобы записать траекторию жеста на этом холсте."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez le bouton gauche de la souris, puis faites glisser pour enregistrer le tracé du geste sur cette zone."
          }
        }
