    "sync.error.tooLarge": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup exceeds the 10 MiB limit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份超过 10 MiB 上限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份超過 10 MiB 上限。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업이 10 MiB 제한을 초과합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップが10 MiBの上限を超えています。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервная копия превышает ограничение 10 MiB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde dépasse la limite de 10 MiB."
          }
        }
      }
    },
    "sync.error.futureVersion": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backup was created by a newer unsupported format."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此备份由当前不支持的更新格式创建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此備份由當前不支援的更新格式建立。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 백업은 지원하지 않는 최신 형식으로 만들어졌습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックアップは、未対応の新しい形式で作成されています。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта резервная копия создана в более новом неподдерживаемом формате."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sauvegarde a été créée dans un format plus récent, non pris en charge."
          }
        }
      }
    },
    "sync.error.invalidBackup": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup is damaged or contains invalid configuration."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份已损坏，或包含无效配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份已損壞，或包含無效配置。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업이 손상되었거나 잘못된 구성이 포함되어 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップが破損しているか、無効な設定が含まれています。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервная копия повреждена или содержит недопустимую конфигурацию."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde est endommagée ou contient une configuration non valide."
          }
        }
      }
    },
    "sync.error.authentication": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider rejected the saved credentials."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商拒绝了已保存的凭据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務商拒絕了已儲存的憑據。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자가 저장된 자격 증명을 거부했습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダが保存済みの認証情報を拒否しました。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Служба отклонила сохранённые учётные данные."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service a rejeté les identifiants enregistrés."
          }
        }
      }
    },
    "sync.error.forbidden": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider denied this operation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商拒绝执行此操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務商拒絕執行此操作。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자가 이 작업을 거부했습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダがこの操作を拒否しました。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Служба запретила эту операцию."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service a refusé cette opération."
          }
        }
      }
    },
    "sync.error.notFound": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remote backup was not found."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到远端备份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到遠端備份。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 백업을 찾지 못했습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートバックアップが見つかりませんでした。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалённая резервная копия не найдена."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde distante est introuvable."
          }
        }
      }
    },
    "sync.error.remoteConflict": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remote destination already contains a conflicting item."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远端位置已存在冲突项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端位置已存在衝突專案。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 대상에 이미 충돌하는 항목이 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートの保存先に競合する項目が既にあります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В удалённом расположении уже есть конфликтующий элемент."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’emplacement distant contient déjà un élément en conflit."
          }
        }
      }
    },
    "sync.error.rateLimited": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider rate-limited this request; try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商限制了本次请求；请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務商限制了本次請求；請稍後再試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자가 이 요청을 제한했으니 나중에 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダがこのリクエストを制限しました。しばらくしてからやり直してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Служба ограничила частоту запросов; повторите попытку позже."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service a limité cette requête ; réessayez plus tard."
          }
        }
      }
    },
    "sync.error.unsafeRedirect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider attempted an unsafe redirect, so the request was stopped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商尝试了不安全的重定向，因此请求已停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務商嘗試了不安全的重定向，因此請求已停止。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자가 안전하지 않은 리디렉션을 시도하여 요청이 중지되었습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダが安全でないリダイレクトを試みたため、リクエストを停止しました。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Служба попыталась выполнить небезопасное перенаправление, поэтому запрос был остановлен."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service a tenté une redirection non sécurisée, la requête a donc été interrompue."
          }
        }
      }
    },
    "sync.error.remote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remote provider returned an invalid response or a network error."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远端服务返回无效响应，或发生网络错误。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端服務返回無效響應，或發生網路錯誤。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 제공자가 잘못된 응답을 반환했거나 네트워크 오류가 발생했습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートプロバイダが無効な応答を返したか、ネットワークエラーが発生しました。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалённая служба вернула недопустимый ответ или произошла сетевая ошибка."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service distant a renvoyé une réponse non valide ou une erreur réseau."
          }
        }
      }
    },
    "sync.error.operationFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sync operation failed without changing local configuration."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步操作失败，未修改本机配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同步操作失敗，未修改本機配置。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화 작업이 실패했으며 로컬 구성은 변경되지 않았습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期操作は失敗し、ローカル設定は変更されていません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Операция синхронизации не удалась, локальная конфигурация не изменена."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’opération de synchronisation a échoué sans modifier la configuration locale."
          }
        }
      }
    },
