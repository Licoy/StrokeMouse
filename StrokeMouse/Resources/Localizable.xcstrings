    "sync.encryption.passwordHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use 12 or more characters and no more than 256 UTF-8 bytes. The password is not trimmed or normalized."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少 12 个字符且不超过 256 个 UTF-8 字节；密码不会被裁剪或规范化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "至少 12 個字元且不超過 256 個 UTF-8 位元組；密碼不會被裁剪或規範化。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "12자 이상, UTF-8 기준 256바이트 이하를 사용하며, 암호는 잘리거나 정규화되지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12文字以上、UTF-8で256バイト以下にしてください。パスワードはトリムも正規化もされません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте не менее 12 символов и не более 256 байт UTF-8. Пароль не обрезается и не нормализуется."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez 12 caractères ou plus, et pas plus de 256 octets UTF-8. Le mot de passe n’est ni rogné ni normalisé."
          }
        }
      }
    },
    "sync.encryption.passwordMismatch": {
      "localizations": {
        "en": {
