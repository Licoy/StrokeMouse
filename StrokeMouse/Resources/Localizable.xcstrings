    "trackpad.directEnabledHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn multi-finger touch recognition on or off without deleting profiles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启或关闭多指触控识别，不会删除手势配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟或關閉多指觸控識別，不會刪除手勢配置。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구성을 삭제하지 않고 여러 손가락 터치 인식을 켜거나 끕니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルを削除せずに、多指タッチ認識のオン/オフを切り替えます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включает или выключает распознавание сенсорных жестов, не удаляя профили."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez ou désactivez la reconnaissance multi-doigts sans supprimer les profils."
          }
        }
      }
    },
    "trackpad.consent.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Experimental Touch Gestures?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用实验性触控手势？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用實驗性觸控手勢？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실험적 터치 제스처를 켤까요?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実験的なタッチジェスチャを有効にしますか？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить экспериментальные сенсорные жесты?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer les gestes tactiles expérimentaux ?"
          }
        }
      }
    },
    "trackpad.consent.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch gestures use Apple's private MultitouchSupport framework. They may stop working after a macOS update and cannot prevent built-in system gestures from also running. If this channel fails, mouse gestures remain available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触控手势使用 Apple 私有的 MultitouchSupport 框架，可能在 macOS 更新后失效，也无法阻止系统自带手势同时运行；即使该通道失败，鼠标手势仍会继续可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "觸控手勢使用 Apple 私有的 MultitouchSupport 框架，可能在 macOS 更新後失效，也無法阻止系統自帶手勢同時執行；即使該通道失敗，滑鼠手勢仍會繼續可用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터치 제스처는 Apple의 비공개 MultitouchSupport 프레임워크를 사용하며, macOS 업데이트 후 작동이 중단될 수 있고 내장 시스템 제스처가 함께 실행되는 것을 막을 수 없습니다. 이 채널이 실패해도 마우스 제스처는 계속 사용할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タッチジェスチャはAppleの非公開MultitouchSupportフレームワークを使用します。macOSのアップデート後に動作しなくなることがあり、システムの標準ジェスチャの同時実行も防げません。このチャネルが失敗しても、マウスジェスチャは引き続き利用できます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сенсорные жесты используют закрытый фреймворк Apple MultitouchSupport. Они могут перестать работать после обновления macOS и не могут помешать одновременному выполнению встроенных системных жестов. Если этот канал откажет, рисование мышью останется доступным."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les gestes tactiles utilisent le framework privé MultitouchSupport d’Apple. Ils peuvent cesser de fonctionner après une mise à jour de macOS et ne peuvent pas empêcher les gestes système de s’exécuter aussi. Si ce canal échoue, les gestes de la souris restent disponibles."
          }
        }
      }
    },
