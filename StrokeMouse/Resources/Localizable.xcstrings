    "onboarding.demo.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each gesture has its own trigger button (default: right click). Hold, draw the path, then release."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个手势有自己的触发键（默认右键），按住 → 画出轨迹 → 松开执行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個手勢有自己的觸發鍵（預設右鍵），按住 → 畫出軌跡 → 鬆開執行。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 제스처마다 트리거 버튼이 있으며(기본값: 오른쪽 클릭), 누른 채 경로를 그린 다음 놓으세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ジェスチャには独自のトリガーボタンがあります（デフォルトは右ボタン）。押したまま軌跡を描き、離して実行します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждого жеста своя кнопка триггера (по умолчанию: правая кнопка). Удерживайте, нарисуйте траекторию, затем отпустите."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque geste a son propre bouton de déclenchement (par défaut : clic droit). Maintenez, dessinez le tracé, puis relâchez."
          }
        }
      }
    },
