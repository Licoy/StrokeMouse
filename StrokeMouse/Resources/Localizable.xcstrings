    "action.shellWarning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shell commands run with your user privileges. Only add trusted commands."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Shell 命令以当前用户权限执行，请只添加可信命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Shell 命令以當前使用者許可權執行，請只新增可信命令。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Shell 명령어는 사용자 권한으로 실행되므로 신뢰할 수 있는 명령만 추가하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Shellコマンドは現在のユーザ権限で実行されます。信頼できるコマンドだけを追加してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команды Shell выполняются с правами вашей учётной записи. Добавляйте только доверенные команды."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les commandes Shell s’exécutent avec vos privilèges utilisateur. N’ajoutez que des commandes de confiance."
          }
        }
      }
    },
