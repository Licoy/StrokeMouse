    "appRule.app.suppressGlobal": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off global gestures in this app"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此应用中停用全局手势"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此應用中停用全域手勢"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱에서 전역 제스처 끄기"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリでグローバルジェスチャをオフ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключить глобальные жесты в этом приложении"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactiver les gestes globaux dans cette app"
          }
        }
      }
    },
    "appRule.group.suppressGlobal": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off global gestures in this group’s apps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在组内应用中停用全局手势"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在組內應用中停用全域手勢"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 그룹의 앱에서 전역 제스처 끄기"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループ内のアプリでグローバルジェスチャをオフ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключить глобальные жесты в приложениях группы"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactiver les gestes globaux dans les apps du groupe"
          }
        }
      }
    },
    "appRule.suppressHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse buttons without an applicable gesture go straight to the app, so right-drag, press-and-hold and other native actions keep working."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可用手势的鼠标按键会直接交给应用，右键拖拽、长按等原生操作不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可用手勢的滑鼠按鍵會直接交給應用，右鍵拖曳、長按等原生操作不受影響。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적용할 제스처가 없는 마우스 버튼은 앱에 그대로 전달되어 오른쪽 드래그, 길게 누르기 등 기본 동작이 그대로 작동합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使えるジェスチャがないマウスボタンはそのままアプリに渡され、右ドラッグや長押しなどの標準操作はそのまま使えます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопки мыши без подходящих жестов передаются приложению напрямую, поэтому перетаскивание правой кнопкой, удержание и другие стандартные действия работают как обычно."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les boutons de souris sans geste applicable sont transmis directement à l’app : glisser avec le clic droit, maintenir appuyé et les autres actions natives fonctionnent normalement."
          }
        }
      }
    },
    "appRule.app.groupNote": {
