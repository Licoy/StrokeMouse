    "gestures.deleteGroupConfirmMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This group has %lld gesture(s). Delete them with the group, or keep them as global gestures."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该应用组有 %lld 个手势，可以一并删除，也可以保留并转为全局手势。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該應用組有 %lld 個手勢，可以一併刪除，也可以保留並轉為全域手勢。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 그룹에는 제스처 %lld개가 있습니다. 그룹과 함께 삭제하거나 전역 제스처로 유지할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループには %lld 件のジェスチャがあります。グループと一緒に削除するか、グローバルジェスチャとして残せます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В группе жестов: %lld. Удалите их вместе с группой или оставьте как глобальные."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce groupe contient %lld geste(s). Supprimez-les avec le groupe ou conservez-les comme gestes globaux."
          }
        }
      }
    },
