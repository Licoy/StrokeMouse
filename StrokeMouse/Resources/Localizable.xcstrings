    "appGroup.editor.directoryHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps anywhere inside the folder match, useful for a Steam library or engine export folders."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目录及其子目录中的应用都会匹配，适合 Steam 游戏库、引擎导出目录等。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目錄及其子目錄中的應用都會符合，適合 Steam 遊戲庫、引擎匯出目錄等。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더와 하위 폴더에 있는 앱이 모두 일치하므로 Steam 라이브러리나 엔진 내보내기 폴더에 유용합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダとそのサブフォルダ内のアプリがすべて一致します。Steam ライブラリやエンジンの書き出し先などに便利です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подходят все приложения в папке и её подпапках — удобно для библиотеки Steam или папок экспорта движков."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les apps du dossier et de ses sous-dossiers correspondent : pratique pour une bibliothèque Steam ou des exports de moteur."
          }
        }
      }
    },
