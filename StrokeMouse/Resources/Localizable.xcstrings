    "sync.singleProviderFooter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only one provider can be active. Disconnect before switching; disconnecting never deletes remote backups."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一时间只能连接一个服务；切换前请先断开，断开连接不会删除远端备份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一時間只能連線一個服務；切換前請先斷開，斷開連線不會刪除遠端備份。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 제공자는 하나만 가능하며, 전환하기 전에 연결을 해제하세요. 연결을 해제해도 원격 백업은 삭제되지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同時に使えるプロバイダは1つだけです。切り替える前に接続を解除してください。解除してもリモートのバックアップは削除されません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одновременно может быть активна только одна служба. Перед сменой отключитесь; отключение никогда не удаляет удалённые резервные копии."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul service peut être actif. Déconnectez avant de changer ; la déconnexion ne supprime jamais les sauvegardes distantes."
          }
        }
      }
    },
