    "action.shortcutHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the field or Record, then press the shortcut. Modifier-only shortcuts (e.g. ⌘⇧) are supported."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击输入框或「录制」后按下快捷键；支持仅修饰键组合（如 ⌘⇧）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選輸入框或「錄製」後按下快捷鍵；支援僅修飾鍵組合（如 ⌘⇧）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필드나 기록을 클릭한 뒤 단축키를 누르며, 보조 키만으로 된 단축키(예: ⌘⇧)도 지원됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィールドまたは「記録」をクリックしてからショートカットを押します。修飾キーのみのショートカット（例: ⌘⇧）にも対応しています。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Щёлкните поле или «Записать», затем нажмите сочетание. Поддерживаются сочетания только из модификаторов (например, ⌘⇧)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez dans le champ ou sur Enregistrer, puis appuyez sur le raccourci. Les raccourcis composés uniquement de touches de modification (p. ex. ⌘⇧) sont pris en charge."
          }
        }
      }
    },
    "action.openAppEmpty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No app selected. Choose an app to open when this gesture matches."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未选择应用，选择一个应用后，匹配到手势时将打开它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未選擇應用，選擇一個應用後，匹配到手勢時將開啟它。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 앱이 없으며, 이 제스처가 일치할 때 열 앱을 선택하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが選択されていません。このジェスチャが一致したときに開くアプリを選んでください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение не выбрано: выберите приложение, которое будет открываться при совпадении жеста."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune app sélectionnée. Choisissez une app à ouvrir lorsque ce geste correspond."
          }
        }
      }
    },
