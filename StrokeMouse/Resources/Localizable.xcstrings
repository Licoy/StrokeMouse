    "scroll.main.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll enhancement stays independent of gesture pause, so you can try it while Settings is open."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滚动增强不受暂停手势影响，打开设置时也可以直接试滚。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "捲動增強不受暫停手勢影響，打開設定時也可以直接試捲。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크롤 향상은 제스처 일시 정지와 별개이므로, 설정을 연 상태에서도 바로 시험할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクロール強化はジェスチャの一時停止とは独立しているため、設定を開いたまま試せます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Улучшение прокрутки не зависит от паузы жестов, его можно проверить прямо в настройках."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le défilement amélioré est indépendant de la pause des gestes, vous pouvez l’essayer pendant que les réglages sont ouverts."
          }
        }
      }
    },
