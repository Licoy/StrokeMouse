    "scroll.smooth.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Holding Command, Option, Control, or Shift keeps native scrolling. While smoothing is on, distance uses the step here instead of the system scroll speed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Command、Option、Control 或 Shift 滚动时保持系统原生行为，开启平滑后滚动距离由这里的步长决定，不再跟随系统滚动速度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Command、Option、Control 或 Shift 捲動時保持系統原生行為，開啟平滑後捲動距離由這裡的步長決定，不再跟隨系統捲動速度。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Command, Option, Control 또는 Shift를 누른 채 스크롤하면 시스템 기본 동작을 유지합니다. 부드러운 스크롤을 켜면 거리는 시스템 속도 대신 여기의 보폭을 사용합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Command、Option、Control、Shift を押したスクロールはシステムのままです。滑らかさをオンにすると、距離はシステムの速度ではなくここの歩幅を使います。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокрутка с Command, Option, Control или Shift остаётся системной. При сглаживании расстояние берётся из шага здесь, а не из системной скорости."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenir Command, Option, Control ou Shift conserve le défilement natif. Quand le lissage est actif, la distance utilise le pas défini ici plutôt que la vitesse du système."
          }
        }
      }
    },
