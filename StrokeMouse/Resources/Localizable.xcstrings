    "onboarding.welcome.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to StrokeMouse"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎使用 StrokeMouse"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歡迎使用 StrokeMouse"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "StrokeMouse에 오신 것을 환영합니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "StrokeMouseへようこそ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добро пожаловать в StrokeMouse"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bienvenue dans StrokeMouse"
          }
        }
      }
    },
    "onboarding.welcome.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold a mouse button, draw a stroke, release — your custom action fires."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住鼠标按键，画出轨迹，松开即可触发自定义动作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住滑鼠按鍵，畫出軌跡，鬆開即可觸發自定義動作。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마우스 버튼을 누른 채 스트로크를 그린 다음 놓으면 사용자 설정 동작이 실행됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウスボタンを押しながら軌跡を描き、離すとカスタムアクションが実行されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте кнопку мыши, нарисуйте траекторию и отпустите — выполнится ваше действие."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez un bouton de la souris, dessinez un tracé, relâchez : votre action personnalisée s’exécute."
          }
        }
      }
    },
    "onboarding.permission.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Accessibility"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启辅助功能权限"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟輔助使用許可權"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용 켜기"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティを有効にする"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Универсальный доступ"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer l’Accessibilité"
          }
        }
      }
    },
    "onboarding.permission.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StrokeMouse needs Accessibility to listen for mouse buttons and run gestures. We’ll open System Settings and show a helper so you can drag the app into the list."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "StrokeMouse 需要「辅助功能」权限才能监听鼠标按键并执行手势，我们会打开系统设置，并显示悬浮辅助面板，方便你把应用拖入列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "StrokeMouse 需要「輔助使用」許可權才能監聽滑鼠按鍵並執行手勢，我們會開啟系統設定，並顯示懸浮輔助面板，方便你把應用拖入列表。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "StrokeMouse는 마우스 버튼을 수신하고 제스처를 실행하려면 손쉬운 사용이 필요하며, 시스템 설정을 열고 앱을 목록에 끌어 넣을 수 있도록 도우미를 표시합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "StrokeMouseがマウスボタンを監視してジェスチャを実行するには、アクセシビリティが必要です。システム設定を開き、アプリをリストにドラッグできるよう補助パネルを表示します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "StrokeMouse требуется «Универсальный доступ», чтобы отслеживать кнопки мыши и выполнять жесты. Мы откроем «Системные настройки» и покажем вспомогательную панель, чтобы вы могли перетащить приложение в список."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "StrokeMouse a besoin de l’Accessibilité pour écouter les boutons de la souris et exécuter les gestes. Nous ouvrirons Réglages Système et afficherons un assistant pour que vous puissiez glisser l’app dans la liste."
          }
        }
      }
    },
    "onboarding.permission.granted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility is granted. Gesture listening can start."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能已授权，可以开始手势监听。"
          }
