    "gestureTest.modifierInstruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold exactly one modifier and move the pointer to test trackpad draw."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住一个修饰键并移动指针，测试触控板绘制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住一個修飾鍵並移動指標，測試觸控式軌跡板繪製。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보조 키 하나만 정확히 누른 채 포인터를 움직여 트랙패드 그리기를 테스트하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修飾キーを1つだけ押しながらポインタを動かして、トラックパッド描画をテストします。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте ровно одну клавишу-модификатор и перемещайте указатель, чтобы проверить рисование на трекпаде."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez exactement une touche de modification et déplacez le pointeur pour tester le dessin trackpad."
          }
        }
      }
    },
    "gestureTest.directInstruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the physical trackpad to test multi-finger recognition."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用真实触控板测试多指识别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用真實觸控式軌跡板測試多指識別。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 트랙패드로 여러 손가락 인식을 테스트하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際のトラックパッドで多指認識をテストします。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте физический трекпад, чтобы проверить распознавание нескольких пальцев."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le trackpad physique pour tester la reconnaissance multi-doigts."
          }
        }
      }
    },
