          }
        }
      }
    },
    "sync.error.compensation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore failed and rollback compensation also failed; inspect the local configuration before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复失败且补偿回滚也失败；继续前请检查本机配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復失敗且補償回滾也失敗；繼續前請檢查本機配置。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원에 실패했고 롤백 보상도 실패했으니, 계속하기 전에 로컬 구성을 검사하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元に失敗し、補償ロールバックも失敗しました。続ける前にローカル設定を確認してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановление не удалось, и компенсационный откат тоже не удался; перед продолжением проверьте локальную конфигурацию."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauration a échoué et la compensation de restauration a aussi échoué ; inspectez la configuration locale avant de continuer."
          }
        }
      }
    },
    "sync.error.localTransactionCompensation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local credentials or sync metadata may not have been fully restored; check the connection before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机凭据或同步元数据可能未完全恢复；继续前请检查同步连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機憑據或同步後設資料可能未完全恢復；繼續前請檢查同步連線。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 자격 증명이나 동기화 메타데이터가 완전히 복원되지 않았을 수 있으니, 계속하기 전에 연결을 확인하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルの認証情報または同期メタデータが完全に復元されていない可能性があります。続ける前に接続を確認してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальные учётные данные или метаданные синхронизации могли быть восстановлены не полностью; перед продолжением проверьте подключение."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les identifiants locaux ou les métadonnées de synchronisation n’ont peut-être pas été entièrement restaurés ; vérifiez la connexion avant de continuer."
          }
        }
      }
    },
    "sync.error.storedConfiguration": {
      "localizations": {
