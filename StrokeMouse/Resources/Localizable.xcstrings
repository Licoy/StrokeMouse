    "general.doubleHideMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "StrokeMouse will keep running in the background with no Dock or menu bar icon. Open it again from Spotlight or Launchpad to reach Settings, and quit from General settings (or ⌘Q while Settings is open)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "StrokeMouse 将在后台继续运行，且没有 Dock 与菜单栏图标；请通过聚焦搜索或启动台再次打开以进入设置；退出请到「通用」设置（或在设置打开时按 ⌘Q）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "StrokeMouse 將在後臺繼續執行，且沒有 Dock 與選單欄圖示；請透過聚焦搜尋或啟動臺再次開啟以進入設定；退出請到「通用」設定（或在設定開啟時按 ⌘Q）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "StrokeMouse는 Dock이나 메뉴 막대 아이콘 없이 백그라운드에서 계속 실행되며, Spotlight나 Launchpad에서 다시 열어 설정에 들어가고, 일반 설정에서 종료하세요(또는 설정이 열려 있을 때 ⌘Q)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "StrokeMouseはDockもメニューバーアイコンもないままバックグラウンドで動作し続けます。設定を開くにはSpotlightまたはLaunchpadから再度開き、「一般」設定から終了してください（設定を開いているときは⌘Qでも終了できます）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "StrokeMouse продолжит работать в фоне без значков Dock и строки меню. Снова откройте его через Spotlight или Launchpad, чтобы перейти в Настройки, и завершите работу в разделе «Основные» (или нажмите ⌘Q, когда Настройки открыты)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "StrokeMouse continuera de s’exécuter en arrière-plan sans icône dans le Dock ni dans la barre des menus. Rouvrez-le depuis Spotlight ou Launchpad pour accéder aux Réglages, et quittez depuis les réglages Général (ou ⌘Q lorsque les Réglages sont ouverts)."
          }
        }
      }
    },
