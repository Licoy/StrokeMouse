    "general.hideChromeFooter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the menu bar icon is hidden, open StrokeMouse again from the Dock, Launchpad, or Spotlight to show Settings. If both icons are hidden, use Spotlight or Launchpad. Quit from General settings or press ⌘Q while Settings is frontmost."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏菜单栏图标后，可通过 Dock、启动台或聚焦搜索再次打开 StrokeMouse 进入设置；若同时隐藏 Dock 图标，请使用聚焦搜索或启动台打开；退出请到「通用」设置，或在设置窗口前台时按 ⌘Q。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱藏選單欄圖示後，可透過 Dock、啟動臺或聚焦搜尋再次開啟 StrokeMouse 進入設定；若同時隱藏 Dock 圖示，請使用聚焦搜尋或啟動臺開啟；退出請到「通用」設定，或在設定視窗前臺時按 ⌘Q。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대 아이콘을 가리면 Dock, Launchpad 또는 Spotlight에서 StrokeMouse를 다시 열어 설정을 표시하며, 두 아이콘을 모두 가리면 Spotlight나 Launchpad를 사용하고, 일반 설정에서 종료하거나 설정이 전면일 때 ⌘Q를 누르세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーアイコンを非表示にした場合は、Dock、Launchpad、またはSpotlightからStrokeMouseを再度開いて設定を表示します。両方のアイコンを非表示にしている場合は、SpotlightまたはLaunchpadを使ってください。終了するには「一般」設定を使うか、設定が最前面のときに⌘Qを押します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если значок в строке меню скрыт, снова откройте StrokeMouse из Dock, Launchpad или Spotlight, чтобы показать Настройки. Если скрыты оба значка, используйте Spotlight или Launchpad. Завершите работу в разделе «Основные» или нажмите ⌘Q, когда окно Настроек активно."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque l’icône de la barre des menus est masquée, rouvrez StrokeMouse depuis le Dock, Launchpad ou Spotlight pour afficher les Réglages. Si les deux icônes sont masquées, utilisez Spotlight ou Launchpad. Quittez depuis les réglages Général, ou appuyez sur ⌘Q lorsque les Réglages sont au premier plan."
          }
        }
      }
    },
    "general.quitApp": {
      "localizations": {
