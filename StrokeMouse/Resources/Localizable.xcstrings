    "permissions.accessibilityGranted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Granted — gesture listening can run."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已授权 — 手势监听可以运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已授權 — 手勢監聽可以執行。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용됨 — 제스처 수신을 실행할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可済み — ジェスチャの監視を実行できます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешено — прослушивание жестов может работать."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisé — l’écoute des gestes peut fonctionner."
          }
        }
      }
    },
    "permissions.accessibilityDenied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not granted — global mouse gestures will not work."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未授权 — 全局鼠标手势无法工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未授權 — 全域性滑鼠手勢無法工作。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용되지 않음 — 전역 마우스 제스처가 작동하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未許可 — グローバルなマウスジェスチャは動作しません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не разрешено — глобальные жесты мыши не будут работать."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non autorisé — les gestes de souris globaux ne fonctionneront pas."
          }
        }
      }
    },
    "permissions.accessibilityFooter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Required to observe mouse buttons and inject keyboard / window actions. If the system toggle is on but this page still shows denied, remove StrokeMouse from Privacy → Accessibility, quit the app, reopen it, then enable it again (common after re-signing)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于监听鼠标按键，以及注入快捷键 / 窗口操作；若系统开关已打开但此处仍显示未授权，请在「隐私与安全性 → 辅助功能」中移除 StrokeMouse，完全退出应用后重新打开，再重新打开开关（更换签名证书后常见）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於監聽滑鼠按鍵，以及注入快捷鍵 / 視窗操作；若系統開關已開啟但此處仍顯示未授權，請在「隱私與安全性 → 輔助使用」中移除 StrokeMouse，完全退出應用後重新開啟，再重新開啟開關（更換簽名證書後常見）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마우스 버튼 관찰과 키보드 / 윈도우 동작 주입에 필요하며, 시스템 스위치가 켜져 있는데도 이 페이지가 거부됨으로 표시되면 개인 정보 보호 → 손쉬운 사용에서 StrokeMouse를 제거한 뒤 앱을 종료하고 다시 연 다음 다시 켜세요(서명 변경 후 흔함)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウスボタンの監視と、キーボード／ウインドウ操作の注入に必要です。システムのスイッチはオンなのにこのページが未許可のままなら、「プライバシーとセキュリティ → アクセシビリティ」からStrokeMouseを取り除き、アプリを終了して開き直し、もう一度オンにしてください（署名のやり直し後によくあります）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необходимо для отслеживания кнопок мыши и внедрения действий клавиатуры и окон. Если системный переключатель включён, но на этой странице по-прежнему указано «не разрешено», удалите StrokeMouse из «Конфиденциальность и безопасность → Универсальный доступ», полностью завершите приложение, откройте его снова и включите доступ ещё раз (часто требуется после повторной подписи)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessaire pour observer les boutons de la souris et injecter des actions clavier ou de fenêtre. Si l’option système est activée mais que cette page indique encore un refus, retirez StrokeMouse de Confidentialité et sécurité → Accessibilité, quittez l’app, rouvrez-la, puis réactivez l’option (fréquent après une nouvelle signature)."
          }
        }
      }
    },
