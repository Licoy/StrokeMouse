    "onboarding.done.bodyReady": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings anytime to tweak gestures. Happy stroking!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时可在设置中调整手势，开始绘制吧！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨時可在設定中調整手勢，開始繪製吧！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언제든지 설정에서 제스처를 조정할 수 있으니, 마음껏 그려 보세요!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定からいつでもジェスチャを調整できます。さっそく描いてみましょう！"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте «Настройки» в любое время, чтобы подправить жесты. Приятного рисования!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez les Réglages à tout moment pour ajuster vos gestes, et bon dessin !"
          }
        }
      }
    },
    "onboarding.done.bodyPartial": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestures won’t run until Accessibility is granted. Use the menu bar item or Permissions tab to finish setup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未授予辅助功能前手势无法运行，可从菜单栏或「权限」页完成授权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未授予輔助使用前手勢無法執行，可從選單欄或「許可權」頁完成授權。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손쉬운 사용이 허용되기 전에는 제스처가 실행되지 않으며, 메뉴 막대 항목이나 권한 탭에서 설정을 마칠 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティが許可されるまでジェスチャは動作しません。メニューバーまたは「権限」タブから設定を完了してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жесты не будут работать, пока не разрешён Универсальный доступ; завершите настройку через значок в строке меню или вкладку «Доступ»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les gestes ne fonctionneront pas tant que l’Accessibilité n’est pas accordée ; utilisez l’élément de la barre des menus ou l’onglet Autorisations pour terminer la configuration."
          }
        }
      }
    },
