    "editor.scopeEmpty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No apps selected. This gesture will not match any app until you add at least one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未选择应用，添加至少一个应用后，该手势才会生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未選擇應用，新增至少一個應用後，該手勢才會生效。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 앱이 없으며, 하나 이상 추가해야 이 제스처가 앱과 일치합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが選択されていません。少なくとも1つ追加するまで、このジェスチャはどのアプリにも一致しません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения не выбраны: жест не будет срабатывать, пока вы не добавите хотя бы одно."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune app sélectionnée ; ce geste ne correspondra à aucune app tant que vous n’en aurez pas ajouté au moins une."
          }
        }
      }
    },
